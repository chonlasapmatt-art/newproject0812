# Public browser configuration — safe to expose. Use your own project values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
NEXT_PUBLIC_SITE_URL=https://YOUR_PUBLIC_SITE_URL

# Local-only admin preview. Keep false in production.
NEXT_PUBLIC_ADMIN_PREVIEW_MODE=false

# PromptPay destination the checkout QR is built from.
#
# This one is deliberately public: the payload of every QR the site renders
# contains it, and it is the same number printed on the counter standee. It is
# a destination for money, not a credential — nothing can be withdrawn with it.
# Accepts a 10-digit mobile number, a 13-digit national id or a 15-digit
# e-wallet id.
NEXT_PUBLIC_PROMPTPAY_ID=0XXXXXXXXX
NEXT_PUBLIC_PROMPTPAY_NAME=ACCOUNT HOLDER NAME

# Edge Function secrets — configure with Supabase CLI; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=SET_IN_SUPABASE_SECRETS_ONLY
OPENAI_API_KEY=SET_IN_SUPABASE_SECRETS_ONLY
OPENAI_MODEL=gpt-5-mini
CORS_ALLOWED_ORIGINS=https://YOUR_PUBLIC_SITE_URL

# Slip verification provider. Without a key the checkout still reads the QR on
# an uploaded slip and blocks reuse, but a human confirms payment; with one, the
# transfer is checked against bank records and confirmed automatically.
#
# The same key may be shared with an n8n flow. Two things follow: the free-tier
# quota is consumed by both, and whichever checks second is told the slip is a
# duplicate — verify-slip treats that as "already handled", not as a failure.
SLIP_VERIFY_PROVIDER=slipok
SLIPOK_API_KEY=SET_IN_SUPABASE_SECRETS_ONLY
SLIPOK_BRANCH_ID=YOUR_BRANCH_ID
# Optional. Defaults to https://api.slipok.com/api/line/apikey/$SLIPOK_BRANCH_ID.
# This is the API endpoint, NOT the /api/line/webhook/<id> URL that LINE and n8n
# post to. Set it here if the provider's path differs from that default.
SLIPOK_API_URL=

# Store PromptPay id, server side. verify-slip compares it with the receiving
# account the provider reports, so a real transfer into the wrong account is
# rejected. Digits only.
PROMPTPAY_ID=SET_IN_SUPABASE_SECRETS_ONLY
