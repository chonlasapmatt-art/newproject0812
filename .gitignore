# Dependencies
node_modules/
.npm-cache/
.pnpm-store/
.pnp
.pnp.js

# Build output
dist/
.next/
.next-conflict-*/
out/
build/

# Environment — never commit real secrets (.env.example is tracked on purpose)
.env
.env.*
!.env.example

# Test / tooling artifacts
coverage/
test-results/
playwright-report/
blob-report/
.playwright/
*.tsbuildinfo

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local dev-server state: pid, timestamps and absolute paths from whichever
# machine last ran `dev` or `build`. Rewritten constantly, useful to nobody else.
.vinext/
.wrangler/
dist-standalone/
IMJAI_WEBSITE_CODE.txt

# Local n8n exports contain live webhook URLs and credential references.
# Keep the repeatable builder script, never the generated workflow backup.
artifacts/*.json
